# Rename file to custom_settings.cfg to have custom settings for this particular installation

# Uncomment WITHOUT_BOUNCER to disable bouncing mechanism: all calls will be
# delivered to carriers, even those to DDIs belonging to the platform
##!define WITHOUT_BOUNCER

# Dialog module track_cseq_updates (default 1). Set it to 0 to disable dialog
# CSeq tracking: CSeq increments done by the proxy when answering
# authentication challenges won't be tracked for later in-dialog requests
#!define TRACK_CSEQ_UPDATES 1

# Number of EvAPI worker processes (default 1). Outbound calls wait for the
# CGRateS authorization reply, and its processing (DB, Redis, rtpengine offer)
# runs in these workers: raise it (e.g. 4) on high outbound call rates
#!define EVAPI_WORKERS 1

# EvAPI module wait_idle (default 500000 us) and wait_increase (default 3).
# The EvAPI worker polls its queue every step x wait_idle when idle, with step
# growing up to wait_increase: CGRateS replies may wait up to 1.5 s by default.
# Set them to 5000 and 1 to poll every 5 ms (slightly higher idle CPU usage)
#!define EVAPI_WAIT_IDLE 500000
#!define EVAPI_WAIT_INCREASE 3
